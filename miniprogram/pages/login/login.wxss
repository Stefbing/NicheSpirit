/* ========================================
 * 登录页 — 赛博科幻风
 * 配色：暗色背景 + 霓虹光晕 + 玻璃态卡片
 * ======================================== */

/* ---------- 页面背景 ---------- */
.page {
  min-height: 100vh;
  background: linear-gradient(145deg, #0a0a1a 0%, #151535 30%, #1a1040 60%, #0d0d2b 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* ---------- 背景装饰光晕粒子 ---------- */
.bg-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.35;
  pointer-events: none;
  z-index: 0;
}
.bg-orb-1 {
  width: 600rpx; height: 600rpx;
  background: radial-gradient(circle, #667eea, transparent 70%);
  top: -180rpx; right: -120rpx;
  animation: orb-float 7s ease-in-out infinite;
}
.bg-orb-2 {
  width: 450rpx; height: 450rpx;
  background: radial-gradient(circle, #764ba2, transparent 70%);
  bottom: -120rpx; left: -100rpx;
  animation: orb-float 9s ease-in-out infinite reverse;
}
.bg-orb-3 {
  width: 350rpx; height: 350rpx;
  background: radial-gradient(circle, #00d4ff, transparent 70%);
  top: 30%; left: 60%;
  animation: orb-pulse 5s ease-in-out infinite;
}
.bg-orb-4 {
  width: 250rpx; height: 250rpx;
  background: radial-gradient(circle, #f472b6, transparent 70%);
  top: 60%; left: 10%;
  animation: orb-float 6s ease-in-out infinite;
  animation-delay: -2s;
}
@keyframes orb-float {
  0%, 100% { transform: translate(0, 0); }
  50%      { transform: translate(40rpx, -40rpx); }
}
@keyframes orb-pulse {
  0%, 100% { opacity: 0.25; transform: scale(1); }
  50%      { opacity: 0.45; transform: scale(1.3); }
}

/* ---------- 网格覆盖层 ---------- */
.grid-overlay {
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background-image:
    linear-gradient(rgba(102, 126, 234, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(102, 126, 234, 0.04) 1px, transparent 1px);
  background-size: 60rpx 60rpx;
  animation: grid-scroll 20s linear infinite;
}
@keyframes grid-scroll {
  0%   { transform: translate(0, 0); }
  100% { transform: translate(60rpx, 60rpx); }
}

/* ---------- 扫描线 ---------- */
.scanline {
  position: fixed;
  left: 0; right: 0;
  height: 4rpx;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(90deg, transparent 0%, rgba(0, 212, 255, 0.15) 20%, rgba(0, 212, 255, 0.3) 50%, rgba(0, 212, 255, 0.15) 80%, transparent 100%);
  animation: scanline-move 3s ease-in-out infinite;
}
@keyframes scanline-move {
  0%   { top: 0; opacity: 0; }
  10%  { opacity: 1; }
  90%  { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}

/* ---------- 主卡片 ---------- */
.card {
  width: 100%;
  max-width: 640rpx;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 28rpx;
  padding: 60rpx 52rpx 44rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.5),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.06),
              0 0 60rpx rgba(102, 126, 234, 0.08);
  position: relative;
  z-index: 1;
  animation: ani-fadeInScale 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
  box-sizing: border-box;
}
.card::before {
  content: '';
  position: absolute;
  inset: -2rpx;
  border-radius: 30rpx;
  z-index: -1;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.3), rgba(118, 75, 162, 0.3), rgba(0, 212, 255, 0.15));
  opacity: 0.6;
  animation: card-glow 4s ease-in-out infinite alternate;
}
@keyframes card-glow {
  0%   { opacity: 0.4; }
  100% { opacity: 0.8; }
}
@keyframes ani-fadeInScale {
  from { opacity: 0; transform: scale(0.92); }
  to   { opacity: 1; transform: scale(1); }
}

/* ---------- 模式块入场 ---------- */
.mode-wrap {
  animation: ani-fadeInUp 0.35s cubic-bezier(0.4, 0, 0.2, 1) both;
}
@keyframes ani-fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ---------- 品牌区 ---------- */
.brand-area {
  text-align: center;
  margin-bottom: 32rpx;
}
.brand-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 0 30rpx rgba(102, 126, 234, 0.4);
}
.brand-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  font-weight: 400;
  letter-spacing: 1rpx;
}

/* ---------- 分割线 ---------- */
.divider-line {
  width: 60rpx;
  height: 3rpx;
  background: linear-gradient(90deg, #667eea, #00d4ff, #764ba2);
  border-radius: 2rpx;
  margin: 0 auto 36rpx;
  box-shadow: 0 0 20rpx rgba(102, 126, 234, 0.3);
  animation: divider-expand 0.6s cubic-bezier(0.4, 0, 0.2, 1) both;
}
@keyframes divider-expand {
  from { width: 0; opacity: 0; }
  to   { width: 60rpx; opacity: 1; }
}

/* ---------- 选择卡片 ---------- */
.select-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: background 0.3s, border-color 0.3s, transform 0.2s;
  animation: ani-fadeInUp 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
}
.select-card:active {
  background: rgba(102, 126, 234, 0.1);
  border-color: rgba(102, 126, 234, 0.4);
  transform: scale(0.98);
}
.select-icon-wrap {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: rgba(102, 126, 234, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 20rpx rgba(102, 126, 234, 0.1);
}
.select-icon { font-size: 26rpx; }
.select-body { flex: 1; margin-left: 20rpx; min-width: 0; }
.select-title {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}
.select-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 4rpx;
}
.select-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
  margin-left: 12rpx;
}
.select-card:active .select-arrow { color: #667eea; }

/* ---------- 下拉提示 ---------- */
.pull-hint {
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.25);
  margin-top: 24rpx;
  animation: ani-fadeInUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
  animation-delay: 0.2s;
}
.pull-icon {
  display: inline-block;
  animation: bounce-down 2s ease-in-out infinite;
}
@keyframes bounce-down {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(6rpx); }
}

/* ---------- 二级卡片表头 ---------- */
.form-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 44rpx;
}
.back-btn {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 500;
  padding: 8rpx;
  line-height: 1;
  transition: all 0.2s;
}
.back-btn:active { color: rgba(255, 255, 255, 0.8); }
.form-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 0 20rpx rgba(102, 126, 234, 0.3);
}

/* ---------- 输入组 ---------- */
.input-group {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-bottom: 40rpx;
}
.input-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 96rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
}
.input-row:focus-within {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(102, 126, 234, 0.5);
  box-shadow: 0 0 24rpx rgba(102, 126, 234, 0.12),
              0 0 0 2rpx rgba(102, 126, 234, 0.06);
}
.input-icon { font-size: 30rpx; flex-shrink: 0; line-height: 1; }
.login-input {
  flex: 1; height: 100%; font-size: 30rpx; color: #ffffff;
  background: transparent; border: none; outline: none; padding: 0;
}
.login-input::placeholder { color: rgba(255, 255, 255, 0.25); }
.input-row.auto-filled .login-input { color: rgba(255, 255, 255, 0.6); }
.auto-fill-tip {
  font-size: 20rpx;
  color: rgba(102, 126, 234, 0.6);
  flex-shrink: 0;
}

/* ---------- 提交按钮 ---------- */
.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 2rpx;
  margin-top: 0;
  padding: 0;
}
.submit-btn::after { border: none; }
.submit-btn.disabled:active { transform: none; }
.btn-text {
  position: relative;
  z-index: 1;
  color: inherit;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.submit-btn:not(.disabled) {
  color: #ffffff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.35);
}
.submit-btn:not(.disabled):active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.25);
}

/* ---------- 加载动画 ---------- */
.loading-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  padding: 20rpx 0 12rpx;
}
.loading-dot {
  display: inline-block;
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: #667eea;
  animation: dot-pulse 1.4s ease-in-out infinite both;
  box-shadow: 0 0 12rpx rgba(102, 126, 234, 0.5);
}
.loading-dot-2 { animation-delay: 0.16s; }
.loading-dot-3 { animation-delay: 0.32s; }
@keyframes dot-pulse {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.3; }
  40%           { transform: scale(1); opacity: 1; }
}
.loading-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 1rpx;
}

/* ---------- 错误信息 ---------- */
.error-msg {
  font-size: 24rpx;
  color: #ff6b6b;
  text-align: center;
  margin-top: 20rpx;
  min-height: 34rpx;
  text-shadow: 0 0 20rpx rgba(255, 107, 107, 0.3);
}

/* ========================================
 * 底部行内隐私协议勾选框
 * 模仿丰巢设计：小字体、单行、带勾选框
 * ======================================== */

.footer-privacy {
  margin-top: 24rpx;
  width: 100%;
  max-width: 640rpx;
  position: relative;
  z-index: 1;
  animation: ani-fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.privacy-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 亮红抖动状态 */
.privacy-row.error {
  background: rgba(255, 77, 79, 0.08);
  border: 1rpx solid rgba(255, 77, 79, 0.2);
}

.privacy-row.shake {
  animation: shake 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  15%      { transform: translateX(-12rpx); }
  30%      { transform: translateX(10rpx); }
  45%      { transform: translateX(-8rpx); }
  60%      { transform: translateX(6rpx); }
  75%      { transform: translateX(-4rpx); }
  90%      { transform: translateX(2rpx); }
}

.privacy-checkbox-wrap {
  flex-shrink: 0;
}

.privacy-checkbox {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.privacy-checkbox.checked {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-color: transparent;
  box-shadow: 0 0 16rpx rgba(102, 126, 234, 0.4);
}

.privacy-checkbox .check-icon {
  font-size: 16rpx;
  color: #ffffff;
  font-weight: 700;
}

.privacy-text-inline {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  line-height: 1.4;
}

.privacy-row.error .privacy-text-inline {
  color: #ff4d4f;
}

.privacy-link-inline {
  color: #667eea;
  font-weight: 500;
}

/* ========================================
 * 协议/政策详情底部蒙层弹窗
 * 覆盖底部+两侧，顶部留白
 * ======================================== */

@keyframes maskFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes maskFadeOut {
  from { opacity: 1; }
  to { opacity: 0; }
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
@keyframes slideDown {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}

.agreement-mask {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.agreement-mask:not(.fade-out) {
  animation: maskFadeIn 0.3s ease both;
}

.agreement-mask.fade-out {
  animation: maskFadeOut 0.35s ease both;
  pointer-events: none;
}

/* 顶部空白蒙层区域 */
.agreement-mask-top {
  flex: 1;
  min-height: 20vh;
  background: transparent;
}

/* 底部弹窗主体 — 覆盖底部+两侧 */
.agreement-modal {
  width: 100%;
  background: linear-gradient(145deg, #1a1a3a, #0d0d2b);
  border-radius: 28rpx 28rpx 0 0;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 -16rpx 60rpx rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  max-height: 80vh;
}

/* 底部滑入 */
.agreement-modal.slide-in {
  animation: slideUp 0.35s cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* 底部滑出 */
.agreement-modal.slide-down {
  animation: slideDown 0.35s cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* 顶部栏 */
.agreement-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}

.agreement-tabs {
  display: flex;
  flex: 1;
  gap: 0;
}

.agreement-tab {
  padding: 20rpx 24rpx;
  position: relative;
  text-align: center;
  transition: all 0.3s;
}

.agreement-tab.active .agreement-tab-text {
  color: #ffffff;
}

.agreement-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 3rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 2rpx;
}

.agreement-tab-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
  font-weight: 500;
}

/* 关闭按钮 */
.agreement-close-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
  transition: all 0.2s;
}

.agreement-close-btn:active {
  background: rgba(255, 255, 255, 0.12);
  transform: scale(0.9);
}

.close-icon {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 300;
}

/* 内容滚动区 */
.agreement-content {
  flex: 1;
  padding: 28rpx 32rpx 48rpx;
  box-sizing: border-box;
  max-height: 65vh;
}

.agreement-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10rpx;
  text-shadow: 0 0 20rpx rgba(102, 126, 234, 0.3);
}

.agreement-update {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-bottom: 4rpx;
}

.agreement-article {
  margin-top: 24rpx;
}

.agreement-article-title {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(102, 126, 234, 0.9);
  margin-bottom: 10rpx;
  display: block;
  letter-spacing: 0.5rpx;
}

.agreement-article-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.7;
  display: block;
  white-space: pre-line;
  word-break: break-all;
}
