.page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.card {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 48rpx 48rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
  animation: ani-fadeInScale 0.4s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
  text-align: center;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 48rpx;
}

/* ====== 模式块入场 ====== */
.mode-wrap {
  animation: ani-fadeInUp 0.35s cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* ====== 输入框 ====== */
.input-group {
  margin-bottom: 32rpx;
  animation: ani-fadeInUp 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
}
.input-group:nth-child(2) {
  animation-delay: 0.08s;
}

/* ====== 选择卡片分步入场 ====== */
.select-card {
  animation: ani-fadeInUp 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.input-group label {
  display: block;
  font-size: 28rpx;
  color: #555;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.input-group input {
  width: 100%;
  height: 88rpx;
  background: #f5f6fa;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #1a1a2e;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.input-group input:focus {
  border-color: #667eea;
}

/* ====== 主按钮 ====== */
.btn-primary {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

/* ====== 加载动画 ====== */
.loading-spinner {
  display: inline-block;
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ====== 自动填充提示 ====== */
.auto-fill-tip {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
  padding-left: 4rpx;
}

/* ====== 错误信息 ====== */
.error-msg {
  font-size: 24rpx;
  color: #e74c3c;
  text-align: center;
  margin-top: 20rpx;
  min-height: 34rpx;
}

/* ====== 手机号/密码登录方式选择卡片 ====== */
.select-card {
  display: flex;
  align-items: center;
  background: #f5f6fa;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s, background 0.2s, transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.select-card:active {
  background: #eef0f8;
  border-color: #667eea;
  transform: scale(0.98);
}

.select-icon {
  font-size: 44rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.select-info {
  flex: 1;
  margin-left: 20rpx;
}

.select-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.select-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.select-arrow {
  font-size: 40rpx;
  color: #ccc;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ====== 下拉提示 ====== */
.pull-hint {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 24rpx;
  animation: ani-fadeInUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
  animation-delay: 0.2s;
}

/* ====== 静默登录按钮（备用入口） ====== */
.silent-btn {
  text-align: center;
  font-size: 26rpx;
  color: #667eea;
  margin-top: 12rpx;
  padding: 16rpx 0;
  border: 2rpx solid #667eea;
  border-radius: 40rpx;
  transition: opacity 0.2s, transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.silent-btn:active {
  opacity: 0.6;
  transform: scale(0.97);
}

/* ====== 返回链接 ====== */
.link-btn {
  text-align: center;
  font-size: 26rpx;
  color: #667eea;
  margin-top: 28rpx;
  padding: 12rpx 0;
  transition: opacity 0.2s, transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.link-btn:active {
  opacity: 0.7;
  transform: translateX(4rpx);
}

/* ====== 底部 ====== */
.footer {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}
