.page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.card {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 48rpx 48rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
  text-align: center;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 52rpx;
}

.input-group {
  margin-bottom: 32rpx;
}

.input-group label {
  display: block;
  font-size: 28rpx;
  color: #555;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.input-group input {
  width: 100%;
  height: 88rpx;
  background: #f5f6fa;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #1a1a2e;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.input-group input:focus {
  border-color: #667eea;
}

.btn-primary {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.loading-spinner {
  display: inline-block;
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.error-msg {
  font-size: 24rpx;
  color: #e74c3c;
  text-align: center;
  margin-top: 20rpx;
  min-height: 34rpx;
}

.divider {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  margin: 28rpx 0;
  position: relative;
}

.divider::before,
.divider::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 30%;
  height: 1rpx;
  background: #e0e0e0;
}

.divider::before { left: 0; }
.divider::after { right: 0; }

.footer {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}
