/* ========================================
 * 登录页 — 极简科技风
 * 配色：蓝紫渐变 + 暗色玻璃态
 * ======================================== */

/* ---------- 页面背景 ---------- */
.page {
  min-height: 100vh;
  background: linear-gradient(145deg, #0f0c29 0%, #1a1a4e 30%, #24243e 70%, #0f0c29 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* ---------- 背景装饰光晕 ---------- */
.bg-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.3;
  pointer-events: none;
  z-index: 0;
}
.bg-orb-1 {
  width: 500rpx; height: 500rpx;
  background: radial-gradient(circle, #667eea, transparent);
  top: -120rpx; right: -100rpx;
  animation: orb-float 6s ease-in-out infinite;
}
.bg-orb-2 {
  width: 400rpx; height: 400rpx;
  background: radial-gradient(circle, #764ba2, transparent);
  bottom: -80rpx; left: -100rpx;
  animation: orb-float 8s ease-in-out infinite reverse;
}
.bg-orb-3 {
  width: 300rpx; height: 300rpx;
  background: radial-gradient(circle, #4facfe, transparent);
  top: 40%; left: 50%;
  transform: translate(-50%, -50%);
  animation: orb-pulse 4s ease-in-out infinite;
}

@keyframes orb-float {
  0%, 100% { transform: translate(0, 0); }
  50%      { transform: translate(30rpx, -30rpx); }
}
@keyframes orb-pulse {
  0%, 100% { opacity: 0.2; transform: translate(-50%, -50%) scale(1); }
  50%      { opacity: 0.4; transform: translate(-50%, -50%) scale(1.2); }
}

/* ---------- 主卡片（玻璃态） ---------- */
.card {
  width: 100%;
  max-width: 640rpx;
  background: rgba(255, 255, 255, 0.06);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 32rpx;
  padding: 52rpx 40rpx 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.4),
              inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  position: relative;
  z-index: 1;
  animation: ani-fadeInScale 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* ---------- 模式块入场 ---------- */
.mode-wrap {
  animation: ani-fadeInUp 0.35s cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* ---------- 品牌区 ---------- */
.brand-icon {
  display: block;
  text-align: center;
  font-size: 56rpx;
  margin-bottom: 16rpx;
  filter: drop-shadow(0 0 20rpx rgba(102, 126, 234, 0.5));
  animation: brand-glow 3s ease-in-out infinite;
}
@keyframes brand-glow {
  0%, 100% { filter: drop-shadow(0 0 20rpx rgba(102, 126, 234, 0.3)); }
  50%      { filter: drop-shadow(0 0 40rpx rgba(102, 126, 234, 0.7)); }
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  margin-bottom: 28rpx;
  letter-spacing: 1rpx;
}

/* ---------- 分割线 ---------- */
.divider-line {
  width: 60rpx;
  height: 3rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 2rpx;
  margin: 0 auto 40rpx;
  animation: divider-expand 0.6s cubic-bezier(0.4, 0, 0.2, 1) both;
}
@keyframes divider-expand {
  from { width: 0; opacity: 0; }
  to   { width: 60rpx; opacity: 1; }
}

/* ---------- 输入框 ---------- */
.input-field {
  margin-bottom: 32rpx;
  position: relative;
  animation: ani-fadeInUp 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
}
.input-field:nth-child(4) {
  animation-delay: 0.06s;
}

.input-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 10rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  padding-left: 4rpx;
}

.td-input {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: #ffffff;
  box-sizing: border-box;
  border: none;
  outline: none;
  transition: background 0.3s;
}

.td-input::placeholder {
  color: rgba(255, 255, 255, 0.2);
}

.td-input:focus {
  background: rgba(255, 255, 255, 0.08);
}

/* 底部装饰线 */
.input-border {
  display: block;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.3), transparent);
  margin-top: -2rpx;
  border-radius: 1rpx;
  transition: opacity 0.3s;
  opacity: 0.6;
}

.td-input:focus + .input-border {
  opacity: 1;
  background: linear-gradient(90deg, #667eea, #764ba2, #667eea);
  background-size: 200% 100%;
  animation: border-shimmer 2s linear infinite;
}

@keyframes border-shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 自动填充态 */
.input-field.auto-filled .td-input {
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 1rpx;
}

.auto-fill-tip {
  display: block;
  font-size: 20rpx;
  color: rgba(102, 126, 234, 0.6);
  margin-top: 8rpx;
  padding-left: 4rpx;
}

/* ---------- 提交按钮 ---------- */
.submit-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  border: none;
  padding: 0;
  margin-top: 40rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.btn-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 46rpx;
  transition: opacity 0.3s, transform 0.3s;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
}

.submit-btn:active .btn-bg {
  transform: scale(0.97);
}

.submit-btn.disabled .btn-bg {
  opacity: 0.3;
}

.btn-text {
  position: relative;
  z-index: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.submit-btn::after {
  border: none;
}

/* ---------- 选择卡片 ---------- */
.select-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  transition: background 0.3s, border-color 0.3s, transform 0.2s;
  animation: ani-fadeInUp 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.select-card:active {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(102, 126, 234, 0.4);
  transform: scale(0.98);
}

.select-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(102, 126, 234, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.select-icon {
  font-size: 28rpx;
  color: #667eea;
}

.select-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.select-title {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

.select-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 4rpx;
}

.select-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.select-card:active .select-arrow {
  color: #667eea;
}

/* ---------- 静默登录按钮 ---------- */
.silent-btn {
  text-align: center;
  font-size: 24rpx;
  color: rgba(102, 126, 234, 0.6);
  margin-top: 16rpx;
  padding: 16rpx 0;
  border: 1rpx solid rgba(102, 126, 234, 0.2);
  border-radius: 40rpx;
  transition: border-color 0.3s, color 0.3s;
}

.silent-btn:active {
  border-color: rgba(102, 126, 234, 0.5);
  color: rgba(102, 126, 234, 0.9);
}

/* ---------- 下拉提示 ---------- */
.pull-hint {
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.25);
  margin-top: 24rpx;
  animation: ani-fadeInUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
  animation-delay: 0.2s;
}

.pull-icon {
  display: inline-block;
  animation: bounce-down 2s ease-in-out infinite;
}
@keyframes bounce-down {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(6rpx); }
}

/* ---------- 加载动画 ---------- */
.loading-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  padding: 20rpx 0 12rpx;
}

.loading-dot {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #667eea;
  animation: dot-pulse 1.4s ease-in-out infinite both;
}
.loading-dot-2 { animation-delay: 0.16s; }
.loading-dot-3 { animation-delay: 0.32s; }

@keyframes dot-pulse {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.3; }
  40%           { transform: scale(1); opacity: 1; }
}

.loading-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  letter-spacing: 1rpx;
}

/* ---------- 错误信息 ---------- */
.error-msg {
  font-size: 24rpx;
  color: #ff6b6b;
  text-align: center;
  margin-top: 20rpx;
  min-height: 34rpx;
  text-shadow: 0 0 20rpx rgba(255, 107, 107, 0.3);
}

/* ---------- 返回链接 ---------- */
.link-btn {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 28rpx;
  padding: 12rpx 0;
  transition: color 0.3s;
}

.link-btn:active {
  color: rgba(255, 255, 255, 0.6);
}

/* ---------- 底部 ---------- */
.footer {
  margin-top: 40rpx;
  text-align: center;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.2);
  position: relative;
  z-index: 1;
}
