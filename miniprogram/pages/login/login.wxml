<view class="page">
  <!-- 背景装饰 -->
  <view class="bg-orb bg-orb-1"></view>
  <view class="bg-orb bg-orb-2"></view>
  <view class="bg-orb bg-orb-3"></view>
  <view class="bg-orb bg-orb-4"></view>
  <view class="grid-overlay"></view>
  <view class="scanline"></view>

  <view class="card">

    <!-- ====== 静默登录中 ====== -->
    <block wx:if="{{loginMode === 'loading'}}">
      <view class="mode-wrap">
        <view class="brand-area">
          <text class="brand-title">冷门器灵</text>
          <text class="brand-desc">智能家居控制中心</text>
        </view>
        <view class="divider-line"></view>
        <view class="loading-area">
          <view class="loading-dot loading-dot-1"></view>
          <view class="loading-dot loading-dot-2"></view>
          <view class="loading-dot loading-dot-3"></view>
          <text class="loading-text">正在进行安全验证…</text>
        </view>
      </view>
    </block>

    <!-- ====== 首次登录：仅手机号注册/登录 ====== -->
    <block wx:elif="{{loginMode === 'phone_only'}}">
      <view class="mode-wrap">
        <view class="brand-area">
          <text class="brand-title">冷门器灵</text>
          <text class="brand-desc">智能家居控制中心</text>
        </view>
        <view class="divider-line"></view>

        <view class="input-group">
          <view class="input-row">
            <text class="input-icon">📱</text>
<input class="login-input" type="number" maxlength="11" placeholder="请输入手机号"
               value="{{phoneOnly}}" bindinput="onPhoneOnlyInput" />
          </view>
          <view class="input-row">
            <text class="input-icon">🔒</text>
            <input class="login-input" type="password" maxlength="32" placeholder="请输入密码"
                   value="{{phoneOnlyPassword}}" bindinput="onPhoneOnlyPasswordInput" />
          </view>
        </view>

        <button class="submit-btn {{loading || !phoneOnly || phoneOnly.length !== 11 || !phoneOnlyPassword || phoneOnlyPassword.length < 4 ? 'disabled' : ''}}"
                bindtap="handlePhoneOnlyLogin"
                disabled="{{loading || !phoneOnly || phoneOnly.length !== 11 || !phoneOnlyPassword || phoneOnlyPassword.length < 4}}">
          <text class="btn-text">{{loading ? loadingText : '注册/登录'}}</text>
        </button>

        <view class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</view>
      </view>
    </block>

    <!-- ====== 退出后重入：登录方式选择 ====== -->
    <block wx:elif="{{loginMode === 'select'}}">
      <view class="mode-wrap">
        <view class="brand-area">
          <text class="brand-title">冷门器灵</text>
          <text class="brand-desc">智能家居控制中心</text>
        </view>
        <view class="divider-line"></view>

        <view class="select-card" bindtap="onSelectOwnPassword">
          <view class="select-icon-wrap">
            <text class="select-icon">📱</text>
          </view>
          <view class="select-body">
            <view class="select-title">本机登录</view>
            <view class="select-desc" wx:if="{{lastLogoutPhoneDisplay}}">
              {{lastLogoutPhoneDisplay}}
            </view>
            <view class="select-desc" wx:else>使用上次退出的账号密码登录</view>
          </view>
          <text class="select-arrow">›</text>
        </view>

        <view class="select-card" bindtap="onSelectOtherPhone">
          <view class="select-icon-wrap">
            <text class="select-icon">🌐</text>
          </view>
          <view class="select-body">
            <view class="select-title">其他方式登录</view>
            <view class="select-desc">使用其他账号密码登录</view>
          </view>
          <text class="select-arrow">›</text>
        </view>

        <view class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</view>

        <view class="pull-hint" wx:if="{{canPullDownSilent}}">
          <text class="pull-icon">⬇</text> 下拉可尝试微信静默登录
        </view>
      </view>
    </block>

    <!-- ====== 本账号密码输入 ====== -->
    <block wx:elif="{{loginMode === 'own_password'}}">
      <view class="mode-wrap">
        <view class="form-header">
          <text class="back-btn" bindtap="onBackToSelect">←</text>
          <text class="form-title">本机登录</text>
        </view>

        <view class="input-group">
          <view class="input-row {{isPhoneAutoFilled ? 'auto-filled' : ''}}">
            <text class="input-icon">📱</text>
            <input class="login-input" type="number" maxlength="11" placeholder="请输入手机号"
                   value="{{ownAccountDisplay}}"
                   bindfocus="onOwnAccountFocus" bindinput="onOwnAccountInput" />
            <text class="auto-fill-tip" wx:if="{{isPhoneAutoFilled}}">可修改</text>
          </view>
          <view class="input-row">
            <text class="input-icon">🔒</text>
            <input class="login-input" type="password" maxlength="32" placeholder="请输入密码"
                   value="{{ownPassword}}" bindinput="onOwnPasswordInput" />
          </view>
        </view>

        <button class="submit-btn {{loading || !ownAccount || !ownPassword || ownPassword.length < 4 ? 'disabled' : ''}}"
                bindtap="handleOwnPasswordLogin"
                disabled="{{loading || !ownAccount || !ownPassword || ownPassword.length < 4}}">
          <text class="btn-text">{{loading ? '登录中…' : '登录'}}</text>
        </button>

        <view class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</view>
      </view>
    </block>

    <!-- ====== 其他方式登录 ====== -->
    <block wx:elif="{{loginMode === 'bind'}}">
      <view class="mode-wrap">
        <view class="form-header">
          <text class="back-btn" bindtap="onBackToSelect">←</text>
          <text class="form-title">其他登录</text>
        </view>

        <view class="input-group">
          <view class="input-row">
            <text class="input-icon">📱</text>
            <input class="login-input" type="number" maxlength="11" placeholder="请输入手机号"
                   value="{{account}}" bindinput="onAccountInput" />
          </view>
          <view class="input-row">
            <text class="input-icon">🔒</text>
            <input class="login-input" type="password" maxlength="32" placeholder="请输入密码"
                   value="{{password}}" bindinput="onPasswordInput" />
          </view>
        </view>

        <button class="submit-btn {{loading || !account || account.length !== 11 || !password || password.length < 4 ? 'disabled' : ''}}"
                bindtap="handleBindLogin"
                disabled="{{loading || !account || account.length !== 11 || !password || password.length < 4}}">
          <text class="btn-text">{{loading ? '绑定中…' : '登录并绑定微信'}}</text>
        </button>

        <view class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</view>
      </view>
    </block>

    <!-- ====== 底部行内协议勾选框（所有登录模式下均显示） ====== -->
    <view class="footer-privacy" wx:if="{{loginMode !== 'loading'}}">
      <view class="privacy-row {{privacyError ? 'error' : ''}} {{privacyShaking ? 'shake' : ''}}">
        <view class="privacy-checkbox-wrap" bindtap="toggleInlineAgree">
          <view class="privacy-checkbox {{inlineAgreed ? 'checked' : ''}}">
            <text class="check-icon" wx:if="{{inlineAgreed}}">✓</text>
          </view>
        </view>
        <text class="privacy-text-inline">我已阅读并同意<text class="privacy-link-inline" catchtap="viewAgreement">《服务协议》</text>和<text class="privacy-link-inline" catchtap="viewPolicy">《隐私政策》</text>
        </text>
      </view>
    </view>
  </view>



  <!-- ====== 协议/政策详情底部蒙层弹窗（覆盖底部+两侧，顶部留白） ====== -->
  <view wx:if="{{showAgreementModal}}" class="agreement-mask {{agreementAnimatingOut ? 'fade-out' : ''}}" catchtouchmove="stopPropagation">
    <!-- 顶部空白蒙层区域：点击关闭 -->
    <view class="agreement-mask-top" bindtap="closeAgreementModal"></view>
    <!-- 底部弹窗主体 -->
    <view class="agreement-modal {{agreementAnimatingOut ? 'slide-down' : 'slide-in'}}" catchtap="stopPropagation">
      <!-- 顶部栏 -->
      <view class="agreement-header">
        <view class="agreement-tabs">
          <view class="agreement-tab {{agreementTab === 'service' ? 'active' : ''}}" data-tab="service" bindtap="switchAgreementTab">
            <text class="agreement-tab-text">用户服务协议</text>
          </view>
          <view class="agreement-tab {{agreementTab === 'privacy' ? 'active' : ''}}" data-tab="privacy" bindtap="switchAgreementTab">
            <text class="agreement-tab-text">隐私保护政策</text>
          </view>
        </view>
        <view class="agreement-close-btn" bindtap="closeAgreementModal">
          <text class="close-icon">✕</text>
        </view>
      </view>

      <!-- 内容区 -->
      <scroll-view class="agreement-content" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{agreementTab === 'service'}}">
          <view class="agreement-section-title">用户服务协议</view>
          <view class="agreement-update">更新日期：2026年5月26日</view>
          <view class="agreement-update">生效日期：2026年5月26日</view>
          <block wx:for="{{serviceArticles}}" wx:key="index">
            <view class="agreement-article">
              <text class="agreement-article-title" wx:if="{{item.title}}">{{item.title}}</text>
              <text class="agreement-article-text">{{item.text}}</text>
            </view>
          </block>
        </view>
        <view wx:else>
          <view class="agreement-section-title">隐私保护政策</view>
          <view class="agreement-update">更新日期：2026年5月26日</view>
          <view class="agreement-update">生效日期：2026年5月26日</view>
          <block wx:for="{{privacyArticles}}" wx:key="index">
            <view class="agreement-article">
              <text class="agreement-article-title" wx:if="{{item.title}}">{{item.title}}</text>
              <text class="agreement-article-text">{{item.text}}</text>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>
  </view>

</view>

