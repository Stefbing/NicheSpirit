<view class="page">
  <view class="card">

    <!-- ====== 模式：静默登录中 ====== -->
    <block wx:if="{{loginMode === 'loading'}}">
      <view class="mode-wrap">
        <view class="title">冷门器灵</view>
        <view class="subtitle">正在验证身份…</view>
        <view class="btn-primary" disabled>
          <view class="loading-spinner"></view>
          微信授权中…
        </view>
      </view>
    </block>

    <!-- ====== 模式：登录方式选择 ====== -->
    <block wx:elif="{{loginMode === 'select'}}">
      <view class="mode-wrap">
        <view class="title">冷门器灵</view>
        <view class="subtitle">请选择登录方式</view>

        <view class="error-msg">{{errorMsg}}</view>

        <!-- 本账号密码登录 -->
        <view class="select-card stagger-1" bindtap="onSelectOwnPassword">
          <view class="select-icon">🔐</view>
          <view class="select-info">
            <view class="select-title">本账号密码登录</view>
            <view class="select-desc" wx:if="{{lastLogoutPhone}}">
              上次账号：{{lastLogoutPhone}}
            </view>
            <view class="select-desc" wx:else>使用上次退出的账号密码登录</view>
          </view>
          <view class="select-arrow">›</view>
        </view>

        <!-- 其他手机号绑定 -->
        <view class="select-card stagger-2" bindtap="onSelectOtherPhone">
          <view class="select-icon">📱</view>
          <view class="select-info">
            <view class="select-title">其他手机号登录</view>
            <view class="select-desc">使用新手机号注册或绑定</view>
          </view>
          <view class="select-arrow">›</view>
        </view>

        <view class="pull-hint" wx:if="{{canPullDownSilent}}">
          ⬇ 下拉可尝试微信静默登录
        </view>

        <view class="silent-btn stagger-3" wx:if="{{canPullDownSilent}}" bindtap="onSilentLogin">
          尝试静默登录
        </view>
      </view>
    </block>

    <!-- ====== 模式：本账号密码登录 ====== -->
    <block wx:elif="{{loginMode === 'own_password'}}">
      <view class="mode-wrap">
        <view class="title">冷门器灵</view>
        <view class="subtitle">本账号密码登录</view>

        <view class="input-group">
          <label>手机号</label>
          <input
            type="number"
            maxlength="11"
            placeholder="请输入手机号"
            value="{{ownAccount}}"
            bindinput="onOwnAccountInput"
          />
        </view>

        <view class="input-group">
          <label>密码</label>
          <input
            type="password"
            maxlength="32"
            placeholder="请输入密码（至少6位）"
            value="{{ownPassword}}"
            bindinput="onOwnPasswordInput"
          />
        </view>

        <button
          class="btn-primary"
          bindtap="handleOwnPasswordLogin"
          disabled="{{loading || !ownAccount || !ownPassword || ownPassword.length < 6}}"
        >
          <view class="loading-spinner" wx:if="{{loading}}"></view>
          {{loading ? '登录中…' : '登录'}}
        </button>

        <view class="error-msg">{{errorMsg}}</view>

        <view class="link-btn" bindtap="onBackToSelect">返回登录方式选择</view>
      </view>
    </block>

    <!-- ====== 模式：其他手机号绑定 ====== -->
    <block wx:elif="{{loginMode === 'bind'}}">
      <view class="mode-wrap">
        <view class="title">冷门器灵</view>
        <view class="subtitle">手机号注册 / 绑定</view>

        <view class="input-group">
          <label>手机号</label>
          <input
            type="number"
            maxlength="11"
            placeholder="请输入手机号"
            value="{{account}}"
            bindinput="onAccountInput"
          />
        </view>

        <view class="input-group">
          <label>密码</label>
          <input
            type="password"
            maxlength="32"
            placeholder="请输入密码（至少6位）"
            value="{{password}}"
            bindinput="onPasswordInput"
          />
        </view>

        <button
          class="btn-primary"
          bindtap="handleBindLogin"
          disabled="{{loading || !account || account.length !== 11 || !password || password.length < 6}}"
        >
          <view class="loading-spinner" wx:if="{{loading}}"></view>
          {{loading ? '绑定中…' : '登录并绑定微信'}}
        </button>

        <view class="error-msg">{{errorMsg}}</view>

        <view class="link-btn" bindtap="onBackToSelect">返回登录方式选择</view>
      </view>
    </block>

  </view>

  <view class="footer">首次登录将自动注册并绑定微信</view>
</view>
