<view class="page">
  <!-- 背景装饰光晕粒子 -->
  <view class="bg-orb bg-orb-1"></view>
  <view class="bg-orb bg-orb-2"></view>
  <view class="bg-orb bg-orb-3"></view>
  <view class="bg-orb bg-orb-4"></view>

  <!-- 扫描线网格层 -->
  <view class="grid-overlay"></view>
  <view class="scanline"></view>

  <view class="card">

    <!-- ====== 模式：静默登录中 ====== -->
    <block wx:if="{{loginMode === 'loading'}}">
      <view class="mode-wrap">
        <view class="brand-area">
          <text class="brand-title">冷门器灵</text>
          <text class="brand-desc">智能家居控制中心</text>
        </view>
        <view class="divider-line"></view>
        <view class="loading-area">
          <view class="loading-dot loading-dot-1"></view>
          <view class="loading-dot loading-dot-2"></view>
          <view class="loading-dot loading-dot-3"></view>
          <text class="loading-text">正在进行安全验证…</text>
        </view>
      </view>
    </block>

    <!-- ====== 模式：登录方式选择 ====== -->
    <block wx:elif="{{loginMode === 'select'}}">
      <view class="mode-wrap">
        <view class="brand-area">
          <text class="brand-title">冷门器灵</text>
          <text class="brand-desc">智能家居控制中心</text>
        </view>
        <view class="divider-line"></view>

        <view class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</view>

        <!-- 本机登录 -->
        <view class="select-card" bindtap="onSelectOwnPassword">
          <view class="select-icon-wrap">
            <text class="select-icon">📱</text>
          </view>
          <view class="select-body">
            <view class="select-title">本机登录</view>
            <view class="select-desc" wx:if="{{lastLogoutPhoneDisplay || lastLogoutPhone}}">
              {{lastLogoutPhoneDisplay || lastLogoutPhone}}
            </view>
            <view class="select-desc" wx:else>使用上次退出的账号密码登录</view>
          </view>
          <text class="select-arrow">›</text>
        </view>

        <!-- 其他方式登录 -->
        <view class="select-card" bindtap="onSelectOtherPhone">
          <view class="select-icon-wrap">
            <text class="select-icon">🌐</text>
          </view>
          <view class="select-body">
            <view class="select-title">其他方式登录</view>
            <view class="select-desc">使用其他账号密码登录</view>
          </view>
          <text class="select-arrow">›</text>
        </view>

        <view class="pull-hint" wx:if="{{canPullDownSilent}}">
          <text class="pull-icon">⬇</text> 下拉可尝试微信静默登录
        </view>
      </view>
    </block>

    <!-- ====== 模式：本机登录（原"本账号密码登录"） ====== -->
    <block wx:elif="{{loginMode === 'own_password'}}">
      <view class="mode-wrap">
        <view class="form-header">
          <text class="back-btn" bindtap="onBackToSelect">←</text>
          <text class="form-title">本机登录</text>
        </view>

        <view class="input-group">
          <view class="input-row {{isPhoneAutoFilled ? 'auto-filled' : ''}}">
            <text class="input-icon">📱</text>
            <input
              class="login-input"
              type="text"
              maxlength="11"
              placeholder="请输入手机号"
              value="{{ownAccountDisplay}}"
              bindfocus="onOwnAccountFocus"
              bindinput="onOwnAccountInput"
            />
            <text class="auto-fill-tip" wx:if="{{isPhoneAutoFilled}}">可修改</text>
          </view>

          <view class="input-row">
            <text class="input-icon">🔒</text>
            <input
              class="login-input"
              type="password"
              maxlength="32"
              placeholder="请输入密码（至少4位）"
              value="{{ownPassword}}"
              bindinput="onOwnPasswordInput"
            />
          </view>
        </view>

        <button
          class="submit-btn {{loading || !ownAccount || !ownPassword || ownPassword.length < 4 ? 'disabled' : ''}}"
          bindtap="handleOwnPasswordLogin"
          disabled="{{loading || !ownAccount || !ownPassword || ownPassword.length < 4}}"
        >
          <text class="btn-text">{{loading ? '登录中…' : '登录'}}</text>
        </button>

        <view class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</view>
      </view>
    </block>

    <!-- ====== 模式：其他方式登录（原"其他手机号绑定"） ====== -->
    <block wx:elif="{{loginMode === 'bind'}}">
      <view class="mode-wrap">
        <view class="form-header">
          <text class="back-btn" bindtap="onBackToSelect">←</text>
          <text class="form-title">其他方式登录</text>
        </view>

        <view class="input-group">
          <view class="input-row">
            <text class="input-icon">📱</text>
            <input
              class="login-input"
              type="number"
              maxlength="11"
              placeholder="请输入手机号"
              value="{{account}}"
              bindinput="onAccountInput"
            />
          </view>

          <view class="input-row">
            <text class="input-icon">🔒</text>
            <input
              class="login-input"
              type="password"
              maxlength="32"
              placeholder="请输入密码（至少4位）"
              value="{{password}}"
              bindinput="onPasswordInput"
            />
          </view>
        </view>

        <button
          class="submit-btn {{loading || !account || account.length !== 11 || !password || password.length < 4 ? 'disabled' : ''}}"
          bindtap="handleBindLogin"
          disabled="{{loading || !account || account.length !== 11 || !password || password.length < 4}}"
        >
          <text class="btn-text">{{loading ? '绑定中…' : '登录并绑定微信'}}</text>
        </button>

        <view class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</view>
      </view>
    </block>

  </view>

  <view class="footer">首次登录将自动注册并绑定微信</view>
</view>
