<view class="page">
  <!-- 背景装饰粒子 -->
  <view class="bg-orb bg-orb-1"></view>
  <view class="bg-orb bg-orb-2"></view>
  <view class="bg-orb bg-orb-3"></view>

  <view class="card">

    <!-- ====== 模式：静默登录中 ====== -->
    <block wx:if="{{loginMode === 'loading'}}">
      <view class="mode-wrap">
        <view class="brand-icon">⚡</view>
        <view class="title">冷门器灵</view>
        <view class="subtitle">智能家居控制中心</view>
        <view class="divider-line"></view>
        <view class="loading-area">
          <view class="loading-dot loading-dot-1"></view>
          <view class="loading-dot loading-dot-2"></view>
          <view class="loading-dot loading-dot-3"></view>
          <text class="loading-text">正在进行安全验证…</text>
        </view>
      </view>
    </block>

    <!-- ====== 模式：登录方式选择 ====== -->
    <block wx:elif="{{loginMode === 'select'}}">
      <view class="mode-wrap">
        <view class="brand-icon">⚡</view>
        <view class="title">冷门器灵</view>
        <view class="subtitle">选择登录方式</view>
        <view class="divider-line"></view>

        <view class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</view>

        <!-- 本账号密码登录 -->
        <view class="select-card" bindtap="onSelectOwnPassword">
          <view class="select-icon-wrap">
            <text class="select-icon">⟐</text>
          </view>
          <view class="select-body">
            <view class="select-title">本账号密码登录</view>
            <view class="select-desc" wx:if="{{lastLogoutPhoneDisplay || lastLogoutPhone}}">
              {{lastLogoutPhoneDisplay || lastLogoutPhone}}
            </view>
            <view class="select-desc" wx:else>使用上次退出的账号密码登录</view>
          </view>
          <text class="select-arrow">›</text>
        </view>

        <!-- 其他手机号绑定 -->
        <view class="select-card" bindtap="onSelectOtherPhone">
          <view class="select-icon-wrap">
            <text class="select-icon">⊕</text>
          </view>
          <view class="select-body">
            <view class="select-title">其他手机号登录</view>
            <view class="select-desc">使用新手机号注册或绑定</view>
          </view>
          <text class="select-arrow">›</text>
        </view>

        <view class="pull-hint" wx:if="{{canPullDownSilent}}">
          <text class="pull-icon">⬇</text> 下拉可尝试微信静默登录
        </view>

        <view class="silent-btn" wx:if="{{canPullDownSilent}}" bindtap="onSilentLogin">
          尝试静默登录
        </view>
      </view>
    </block>

    <!-- ====== 模式：本账号密码登录 ====== -->
    <block wx:elif="{{loginMode === 'own_password'}}">
      <view class="mode-wrap">
        <view class="brand-icon">⚡</view>
        <view class="title">冷门器灵</view>
        <view class="subtitle">本账号密码登录</view>
        <view class="divider-line"></view>

        <view class="input-field {{isPhoneAutoFilled ? 'auto-filled' : ''}}">
          <text class="input-label">手机号</text>
          <input
            class="td-input"
            type="text"
            maxlength="11"
            placeholder="请输入手机号"
            value="{{ownAccountDisplay}}"
            bindfocus="onOwnAccountFocus"
            bindinput="onOwnAccountInput"
          />
          <text class="input-border"></text>
          <text class="auto-fill-tip" wx:if="{{isPhoneAutoFilled}}">点击输入框可修改</text>
        </view>

        <view class="input-field">
          <text class="input-label">密码</text>
          <input
            class="td-input"
            type="password"
            maxlength="32"
            placeholder="请输入密码（至少6位）"
            value="{{ownPassword}}"
            bindinput="onOwnPasswordInput"
          />
          <text class="input-border"></text>
        </view>

        <button
          class="submit-btn {{loading || !ownAccount || !ownPassword || ownPassword.length < 6 ? 'disabled' : ''}}"
          bindtap="handleOwnPasswordLogin"
          disabled="{{loading || !ownAccount || !ownPassword || ownPassword.length < 6}}"
        >
          <view class="btn-bg"></view>
          <text class="btn-text">{{loading ? '登录中…' : '登录'}}</text>
        </button>

        <view class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</view>

        <text class="link-btn" bindtap="onBackToSelect">← 返回选择登录方式</text>
      </view>
    </block>

    <!-- ====== 模式：其他手机号绑定 ====== -->
    <block wx:elif="{{loginMode === 'bind'}}">
      <view class="mode-wrap">
        <view class="brand-icon">⚡</view>
        <view class="title">冷门器灵</view>
        <view class="subtitle">手机号注册 / 绑定</view>
        <view class="divider-line"></view>

        <view class="input-field">
          <text class="input-label">手机号</text>
          <input
            class="td-input"
            type="number"
            maxlength="11"
            placeholder="请输入手机号"
            value="{{account}}"
            bindinput="onAccountInput"
          />
          <text class="input-border"></text>
        </view>

        <view class="input-field">
          <text class="input-label">密码</text>
          <input
            class="td-input"
            type="password"
            maxlength="32"
            placeholder="请输入密码（至少6位）"
            value="{{password}}"
            bindinput="onPasswordInput"
          />
          <text class="input-border"></text>
        </view>

        <button
          class="submit-btn {{loading || !account || account.length !== 11 || !password || password.length < 6 ? 'disabled' : ''}}"
          bindtap="handleBindLogin"
          disabled="{{loading || !account || account.length !== 11 || !password || password.length < 6}}"
        >
          <view class="btn-bg"></view>
          <text class="btn-text">{{loading ? '绑定中…' : '登录并绑定微信'}}</text>
        </button>

        <view class="error-msg" wx:if="{{errorMsg}}">{{errorMsg}}</view>

        <text class="link-btn" bindtap="onBackToSelect">← 返回选择登录方式</text>
      </view>
    </block>

  </view>

  <view class="footer">首次登录将自动注册并绑定微信</view>
</view>
