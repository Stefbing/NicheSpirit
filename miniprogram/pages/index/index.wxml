<view class="page">
  <!-- 设备列表（已登录状态） -->
  <view class="device-page">
    <!-- 顶部导航栏 -->
    <view class="page-header">
      <view class="header-left">
        <text class="user-name">{{userInfo.nickname || '用户'}}，{{greeting}}！</text>
      </view>
      <view class="header-right">
        <button class="icon-btn config-btn" bindtap="goToConfig">
          <text class="btn-icon">⚙️</text>
        </button>
        <button class="icon-btn add-btn" bindtap="showAddDeviceModal">
          <text class="btn-icon">➕</text>
        </button>
        <button class="icon-btn share-btn" bindtap="onShareConfirm">
          <text class="share-icon">↗</text>
        </button>
        <button class="icon-btn logout-btn" bindtap="logout">
          <text class="btn-icon">👋</text>
        </button>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{userDevices.length === 0}}" class="empty-state">
      <view class="empty-icon">📱</view>
      <text class="empty-title">暂无设备</text>
      <text class="empty-desc">点击右上角 + 添加你的第一个智能设备</text>
      <button class="add-device-main-btn" bindtap="showAddDeviceModal">添加设备</button>
    </view>

    <!-- 设备分组列表 -->
    <scroll-view wx:else class="device-scroll" scroll-y enable-flex>
      <!-- 宠物生活 -->
      <view wx:if="{{petDevices.length > 0}}" class="device-section">
        <view class="section-header stagger-1">
          <text class="section-icon">🐾</text>
          <text class="section-name">宠物生活</text>
        </view>

        <view class="device-cards">
          <block wx:for="{{petDevices}}" wx:key="device_key">
            <!-- 喂食机卡片 -->
            <navigator wx:if="{{item.device_type === 'feeder'}}"
                       url="/pages/feeder/feeder"
                       class="device-card feeder-card stagger-{{index+1}}"
                       bindlongpress="onLongPressDevice"
                       data-device-key="{{item.device_key}}"
                       data-device-name="{{item.display_name || item.device_name || '喂食机'}}">
              <view class="card-left">
                <view class="card-icon-wrapper feeder">
                  <text class="card-icon">🍖</text>
                  <view class="status-indicator {{item.status === 'active' ? 'online' : 'offline'}}"></view>
                </view>
                <view class="card-info">
                  <text class="card-name">{{item.device_name || '喂食机'}}</text>
                  <view class="card-status">
                    <text class="status-text">{{item.status === 'active' ? '在线' : '待配置'}}</text>
                  </view>
                </view>
              </view>

              <view class="card-stats">
                <view class="stat-item">
                  <text class="stat-value">{{item.today_servings !== undefined ? item.today_servings : '--'}}</text>
                  <text class="stat-unit">次</text>
                  <text class="stat-label">今日投喂</text>
                </view>
                <view class="stat-item">
                  <text class="stat-value">{{item.remaining_plans !== undefined ? item.remaining_plans : '--'}}</text>
                  <text class="stat-unit">个</text>
                  <text class="stat-label">计划剩余</text>
                </view>
              </view>

              <view class="card-chevron">
                <text class="chevron-icon">›</text>
              </view>
            </navigator>

            <!-- 猫厕所卡片 -->
            <navigator wx:if="{{item.device_type === 'litterbox'}}"
                       url="/pages/litterbox/litterbox"
                       class="device-card litterbox-card stagger-{{index+1}}"
                       bindlongpress="onLongPressDevice"
                       data-device-key="{{item.device_key}}"
                       data-device-name="{{item.display_name || item.device_name || '猫厕所'}}">
              <view class="card-left">
                <view class="card-icon-wrapper litterbox">
                  <text class="card-icon">🚽</text>
                  <view class="status-indicator {{item.status === 'active' ? 'online' : 'offline'}}"></view>
                </view>
                <view class="card-info">
                  <text class="card-name">{{item.device_name || '猫厕所'}}</text>
                  <view class="card-status">
                    <text class="status-text">{{item.status === 'active' ? '在线' : '待配置'}}</text>
                  </view>
                </view>
              </view>

              <view class="card-stats">
                <view class="stat-item">
                  <text class="stat-value">{{item.today_visits !== undefined ? item.today_visits : '--'}}</text>
                  <text class="stat-unit">次</text>
                  <text class="stat-label">今日如厕</text>
                </view>
                <view class="stat-item">
                  <text class="stat-value">{{item.sand_level !== undefined ? item.sand_level : '--'}}</text>
                  <text wx:if="{{item.sand_level !== undefined && item.sand_level !== '--'}}" class="stat-unit">%</text>
                  <text class="stat-label">猫砂余量</text>
                </view>
              </view>

              <view class="card-chevron">
                <text class="chevron-icon">›</text>
              </view>
            </navigator>
          </block>
        </view>
      </view>

      <!-- 健康与体质 -->
      <view wx:if="{{healthDevices.length > 0}}" class="device-section">
        <view class="section-header stagger-1">
          <text class="section-icon">⚖️</text>
          <text class="section-name">健康与体质</text>
        </view>

        <view class="device-cards">
          <block wx:for="{{healthDevices}}" wx:key="device_key">
            <!-- 体脂秤卡片 -->
            <navigator wx:if="{{item.device_type === 'scale'}}"
                       url="/pages/scale/scale"
                       class="device-card scale-card stagger-{{index+1}}"
                       bindlongpress="onLongPressDevice"
                       data-device-key="{{item.device_key}}"
                       data-device-name="{{item.display_name || 'MIBFS'}}">
              <view class="card-left">
                <view class="card-icon-wrapper scale">
                  <text class="card-icon">⚖️</text>
                  <view class="status-indicator {{item.connectionStatus === 'online' ? 'online' : (item.connectionStatus === 'scanning' ? 'scanning' : 'offline')}}"></view>
                </view>
                <view class="card-info">
                  <text class="card-name">{{item.display_name || 'MIBFS'}}</text>
                  <view class="card-status">
                    <text class="status-text">{{item.connectionStatus === 'online' ? '在线' : (item.connectionStatus === 'scanning' ? '扫描中' : '离线')}}</text>
                  </view>
                </view>
              </view>

              <view class="card-stats">
                <view class="stat-item" wx:if="{{item.today_measurements !== undefined && item.today_measurements !== null}}">
                  <text class="stat-value">{{item.today_measurements}}</text>
                  <text class="stat-unit">次</text>
                  <text class="stat-label">今日测量</text>
                </view>
                <view class="stat-item" wx:if="{{item.latest_body_fat !== undefined && item.latest_body_fat !== null}}">
                  <text class="stat-value">{{item.latest_body_fat}}</text>
                  <text class="stat-unit">%</text>
                  <text class="stat-label">体脂率</text>
                </view>
                <view class="stat-empty" wx:if="{{(item.today_measurements === undefined || item.today_measurements === null || item.today_measurements === 0) && (item.latest_body_fat === undefined || item.latest_body_fat === null)}}">
                  <text class="empty-text">暂无数据</text>
                </view>
              </view>

              <view class="card-chevron">
                <text class="chevron-icon">›</text>
              </view>
            </navigator>
          </block>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 添加设备弹窗 -->
  <view wx:if="{{showAddDeviceDialog}}" class="modal-mask" bindtap="closeAddDeviceModal">
    <view class="modal-box" catchtap="stopPropagation">
      <view class="modal-title">选择设备类型</view>

      <view class="device-options">
        <view class="option-item" bindtap="selectDeviceType" data-type="feeder" data-platform="cloudpets">
          <view class="option-icon" style="background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);">🍖</view>
          <text class="option-name">喂食机</text>
        </view>

        <view class="option-item" bindtap="selectDeviceType" data-type="litterbox" data-platform="petkit">
          <view class="option-icon" style="background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);">🚽</view>
          <text class="option-name">猫厕所</text>
        </view>

        <view class="option-item" bindtap="selectDeviceType" data-type="scale" data-platform="xiaomi">
          <view class="option-icon" style="background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);">⚖️</view>
          <text class="option-name">体脂秤</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 设备配置弹窗 -->
  <view wx:if="{{showDeviceConfigDialog}}" class="modal-mask" bindtap="closeDeviceConfigModal">
    <view class="modal-box modal-form" catchtap="stopPropagation">
      <view class="modal-title">配置{{selectedDeviceTypeText}}</view>

      <view class="form-group">
        <text class="form-label">设备账号</text>
        <input class="form-input"
               placeholder="请输入账号"
               value="{{deviceAccount}}"
               bindinput="onAccountInput" />
      </view>

      <view class="form-group">
        <text class="form-label">密码</text>
        <input class="form-input"
               type="password"
               placeholder="请输入密码"
               value="{{devicePassword}}"
               bindinput="onPasswordInput" />
      </view>

      <button class="submit-btn" bindtap="onSubmitDeviceConfig">确认添加</button>
    </view>
  </view>

  <!--体脂秤权限说明弹窗-->
  <view wx:if="{{showScalePermissionDialog}}" class="modal-mask" bindtap="closeScalePermissionDialog">
    <view class="modal-box scale-permission-box" catchtap="stopPropagation">
      <view class="scale-perm-icon">⚖️</view>
      <view class="modal-title">绑定体脂秤</view>
      <view class="scale-perm-desc">
        <text>通过手机蓝牙连接体脂秤设备，每次上秤后自动记录体重、体脂率等健康数据，生成管理趋势图表。</text>
      </view>
      <view class="scale-perm-tips">
        <view class="perm-tip-row">
          <text class="tip-bullet">①</text>
          <text class="tip-text">确保体脂秤已安装电池并处于开机状态</text>
        </view>
        <view class="perm-tip-row">
          <text class="tip-bullet">②</text>
          <text class="tip-text">将手机靠近体脂秤（建议 5 米以内）</text>
        </view>
        <view class="perm-tip-row">
          <text class="tip-bullet">③</text>
          <text class="tip-text">需要授权蓝牙权限用于扫描和连接设备</text>
        </view>
      </view>
      <button class="submit-btn scale-bind-btn" bindtap="authorizeAndScan">开始绑定</button>
      <button class="share-cancel-btn" bindtap="closeScalePermissionDialog">取消</button>
    </view>
  </view>

  <!--体脂秤扫描弹窗-->
  <view wx:if="{{showScaleScanningDialog}}" class="modal-mask" bindtap="closeScaleScanDialog">
    <view class="modal-box scale-scan-box" catchtap="stopPropagation">
      <view class="scan-header">
        <view class="scan-icon {{scaleScanning ? 'scanning-anim' : ''}}">🔍</view>
        <text class="modal-title">发现体脂秤</text>
        <text class="scale-scan-hint">{{scaleScanHelp}}</text>
      </view>

      <!--设备列表-->
      <scroll-view class="scale-device-list" scroll-y>
        <view wx:if="{{scaleDiscoveredDevices.length === 0 && !scaleScanning}}" class="no-devices">
          <text class="no-devices-icon">📡</text>
          <text class="no-devices-text">未搜索到体脂秤设备</text>
          <button class="retry-btn" bindtap="startScaleScan">重新搜索</button>
        </view>

        <view wx:for="{{scaleDiscoveredDevices}}" wx:key="deviceId" 
              class="device-item {{item.isDuplicate ? 'device-duplicate' : ''}}"
              bindtap="confirmBindScale"
              data-device-id="{{item.deviceId}}"
              data-device-name="{{item.name}}"
              data-duplicate="{{item.isDuplicate}}">

          <view class="device-item-left">
            <view class="device-item-icon">⚖️</view>
            <view class="device-item-info">
              <text class="device-item-name">{{item.name}}</text>
              <text class="device-item-meta">
                {{item.isDuplicate ? '已绑定' : '信号强度：' + item.signalBars + '/4'}}
              </text>
            </view>
          </view>

          <view class="device-item-right">
            <view wx:if="{{item.isDuplicate}}" class="duplicate-tag">已绑定</view>
            <view wx:else class="signal-bars">
              <view class="signal-bar {{item.signalBars >= 1 ? 'active' : ''}}"></view>
              <view class="signal-bar {{item.signalBars >= 2 ? 'active' : ''}}"></view>
              <view class="signal-bar {{item.signalBars >= 3 ? 'active' : ''}}"></view>
              <view class="signal-bar {{item.signalBars >= 4 ? 'active' : ''}}"></view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="scan-footer">
        <button class="share-cancel-btn" bindtap="closeScaleScanDialog">
          {{scaleDiscoveredDevices.length > 0 ? '关闭' : '取消'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 分享确认弹窗 -->
  <view wx:if="{{showShareConfirm}}" class="modal-mask" bindtap="closeShareConfirm">
    <view class="modal-box" catchtap="stopPropagation">
      <view class="modal-title">分享设备</view>
      <view class="share-desc">
        <text wx:if="{{userDevices.length > 0}}">分享将使对方自动获取并使用您的全部设备</text>
        <text wx:else>当前暂无设备可分享</text>
      </view>
      <view class="share-expiry-tip">
        <text class="expiry-icon">⏰</text>
        <text class="expiry-text">默认有效期为 24 小时</text>
      </view>
      <view class="share-expiry-hint" bindtap="goToExpirySettings">
        <text class="hint-link">前往设置中心修改时效 →</text>
      </view>
      <view class="share-btn-row">
        <button class="share-submit-btn" open-type="share" wx:if="{{userDevices.length > 0}}"
                bindtap="doShare">确认分享</button>
        <button class="share-cancel-btn" bindtap="closeShareConfirm">取消</button>
      </view>
    </view>
  </view>

  <!-- 接受分享弹窗 -->
  <view wx:if="{{showAcceptShare}}" class="modal-mask" bindtap="closeAcceptShare">
    <view class="modal-box" catchtap="stopPropagation">
      <view class="modal-title">📩 设备分享</view>
      <text class="share-desc">{{shareFromName}} 分享了设备给您，是否接受并自动配置？</text>
      <view class="share-btn-row">
        <button class="submit-btn" bindtap="acceptShare">接受并配置</button>
        <button class="share-cancel-btn" bindtap="closeAcceptShare">稍后再说</button>
      </view>
    </view>
  </view>

</view>
