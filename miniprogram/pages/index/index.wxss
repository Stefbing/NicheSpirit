/* 全局页面样式 - UI/UX Pro Max 设计系统 */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
}

/* ========== 设备页 ========== */
.device-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
  overflow: hidden;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}

.header-left {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.2;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.icon-btn {
  width: 56rpx !important;
  height: 56rpx !important;
  min-width: 56rpx !important;
  max-width: 56rpx !important;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F3F4F6;
  border: none;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 1;
  font-size: 0;
  transition: all 0.2s;
}

.icon-btn::after {
  border: none !important;
}

.icon-btn:active {
  transform: scale(0.9);
  opacity: 0.8;
}

.icon-btn.config-btn {
  background: #FEF3C7;
}

.icon-btn.add-btn {
  background: linear-gradient(135deg, #E0F2FE 0%, #BAE6FD 100%);
  box-shadow: 0 4rpx 12rpx rgba(14, 165, 233, 0.15);
}

.icon-btn.logout-btn {
  background: #FEE2E2;
}

.icon-btn.share-btn {
  background: linear-gradient(135deg, #DCFCE7 0%, #BBF7D0 100%);
  box-shadow: 0 4rpx 12rpx rgba(34, 197, 94, 0.15);
}

/* === 分享图标：↗ 符号 === */
.share-icon {
  font-size: 28rpx;
  font-weight: 700;
  color: #6B7280;
  line-height: 1;
}

.btn-icon {
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
}

.empty-icon {
  font-size: 140rpx;
  margin-bottom: 32rpx;
  filter: grayscale(0.3);
  opacity: 0.8;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #6B7280;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.add-device-main-btn {
  width: 360rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.add-device-main-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.2);
}

.add-device-main-btn::after {
  border: none;
}

/* 设备滚动区 */
.device-scroll {
  flex: 1;
  padding: 24rpx 0;
  overflow-y: auto;
}

/* 设备分组 */
.device-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 0 40rpx 24rpx;
  animation: ani-fadeInUp 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* 设备卡片分步入场 */
.device-card {
  animation: ani-fadeInUp 0.35s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.section-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  letter-spacing: 0.5rpx;
}

.device-cards {
  padding: 0 32rpx;
}

.device-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04),
              0 0 0 1rpx rgba(0, 0, 0, 0.02) inset;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.device-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #3B82F6 0%, #8B5CF6 100%);
  opacity: 0;
  transition: opacity 0.3s;
}

.device-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.12),
              0 0 0 1rpx rgba(59, 130, 246, 0.1) inset;
}

.device-card:active::before {
  opacity: 1;
}

.card-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.card-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-icon-wrapper.feeder {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
}

.card-icon-wrapper.litterbox {
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
}

.card-icon-wrapper.scale {
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
}

.card-icon {
  font-size: 48rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.status-indicator {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.status-indicator.online {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: 0 0 12rpx rgba(16, 185, 129, 0.5);
}

.status-indicator.scanning {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  box-shadow: 0 0 12rpx rgba(245, 158, 11, 0.5);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.status-indicator.offline {
  background: #D1D5DB;
}

.card-info {
  flex: 1;
  min-width: 0;
}

/* 通用卡片统计信息（喂食机、猫厕所） */
.card-stats {
  display: flex;
  gap: 32rpx;
  align-items: center;
  margin-left: auto;
}

.stat-item {
  text-align: right;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.2;
  display: inline-block;
  letter-spacing: -0.5rpx;
}

.stat-unit {
  display: inline-block;
  font-size: 20rpx;
  color: #9CA3AF;
  font-weight: 500;
  line-height: 1;
  vertical-align: baseline;
  margin-left: 5rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #9CA3AF;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
  margin-top: 4rpx;
  display: block;
}

.stat-empty {
  text-align: right;
}

.empty-text {
  font-size: 22rpx;
  color: #CBD5E1;
  font-weight: 400;
}

.card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.card-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-text {
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 500;
}

/* 卡片右箭头 */
.card-chevron {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.chevron-icon {
  font-size: 48rpx;
  color: #D1D5DB;
  font-weight: 300;
  line-height: 1;
  transition: all 0.3s;
}

.device-card:active .chevron-icon {
  color: #3B82F6;
  transform: translateX(4rpx);
}

/* ========== 弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-box {
  width: 600rpx;
  max-width: 85vw;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2),
              0 0 0 1rpx rgba(255, 255, 255, 0.5) inset;
  animation: ani-modalUp 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* 遮罩层淡入 */
.modal-mask {
  animation: ani-maskIn 0.2s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  text-align: center;
  margin-bottom: 32rpx;
  letter-spacing: 0.5rpx;
}

/* 设备选项网格 */
.device-options {
  display: flex;
  justify-content: space-around;
  gap: 16rpx;
}

.option-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 24rpx;
  border-radius: 20rpx;
  background: #F8FAFC;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  flex: 1;
}

.option-item:active {
  background: rgba(59, 130, 246, 0.08);
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.15);
}

.option-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.option-item:active .option-icon {
  transform: scale(1.05);
}

.option-name {
  font-size: 28rpx;
  color: #374151;
  font-weight: 600;
}

.modal-header {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  padding: 40rpx 32rpx 32rpx;
  text-align: center;
}

.modal-header .modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

.device-type-list {
  padding: 32rpx;
}

.device-type-card {
  background: linear-gradient(135deg, #F8FAFC 0%, #FFFFFF 100%);
  border: 2rpx solid #E5E7EB;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.device-type-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #3B82F6 0%, #8B5CF6 100%);
  transform: scaleX(0);
  transition: transform 0.3s;
}

.device-type-card:active {
  border-color: #DBEAFE;
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 32rpx rgba(59, 130, 246, 0.15);
}

.device-type-card:active::before {
  transform: scaleX(1);
}

.type-card-content {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

.type-icon-wrapper {
  width: 104rpx;
  height: 104rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  position: relative;
}

.type-icon-wrapper.feeder {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  box-shadow: 0 8rpx 20rpx rgba(245, 158, 11, 0.25);
}

.type-icon-wrapper.litterbox {
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
  box-shadow: 0 8rpx 20rpx rgba(59, 130, 246, 0.25);
}

.type-icon {
  font-size: 52rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.type-info {
  flex: 1;
  min-width: 0;
}

.type-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.type-desc {
  font-size: 24rpx;
  color: #6B7280;
  display: block;
  line-height: 1.4;
}

.type-arrow {
  font-size: 56rpx;
  color: #D1D5DB;
  font-weight: 300;
  margin-left: 16rpx;
  transition: all 0.3s;
}

.device-type-card:active .type-arrow {
  color: #3B82F6;
  transform: translateX(6rpx);
}

.modal-footer {
  padding: 0 32rpx 32rpx;
  text-align: center;
}

.cancel-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #6B7280;
  background: linear-gradient(135deg, #F3F4F6 0%, #E5E7EB 100%);
  border-radius: 16rpx;
  border: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.cancel-btn:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #E5E7EB 0%, #D1D5DB 100%);
}

.cancel-btn::after {
  border: none;
}

/* 表单弹窗 */
.modal-form {
  padding: 40rpx 32rpx 32rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #374151;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.form-input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  padding: 0 20rpx;
  background: #F8FAFC;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-sizing: border-box;
}

.form-input:focus {
  background: #FFFFFF;
  border-color: #3B82F6;
  box-shadow: 0 0 0 4rpx rgba(59, 130, 246, 0.1);
}

.submit-btn {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  border-radius: 14rpx;
  border: none;
  margin-top: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.3);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.2);
}

.submit-btn::after {
  border: none;
}

/* ========== 分享弹窗 ========== */
.share-desc {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #6B7280;
  margin: 24rpx 0 40rpx;
  line-height: 1.5;
}

.share-btn-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.share-submit-btn {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  border-radius: 14rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.3);
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-submit-btn::after { border: none; }

.share-submit-btn:active {
  transform: scale(0.98);
}

.share-cancel-btn {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #6B7280;
  background: linear-gradient(135deg, #F3F4F6 0%, #E5E7EB 100%);
  border-radius: 14rpx;
  border: none;
  transition: all 0.3s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-cancel-btn::after { border: none; }

.share-cancel-btn:active {
  transform: scale(0.98);
}

/* ========== 体脂秤权限说明弹窗 ========== */
.scale-permission-box {
  text-align: center;
  padding: 48rpx 36rpx 36rpx;
}

.scale-perm-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.scale-perm-desc {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.7;
  text-align: left;
  margin-bottom: 28rpx;
}

.scale-perm-tips {
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 36rpx;
  text-align: left;
}

.perm-tip-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.perm-tip-row:last-child {
  margin-bottom: 0;
}

.tip-bullet {
  font-size: 24rpx;
  color: #3B82F6;
  font-weight: 600;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #4B5563;
  line-height: 1.5;
}

.scale-bind-btn {
  margin-top: 0;
  margin-bottom: 16rpx;
}

/* ========== 体脂秤扫描弹窗 ========== */
.scale-scan-box {
  max-height: 75vh;
  display: flex;
  flex-direction: column;
  padding: 32rpx 32rpx 24rpx;
}

.scan-header {
  text-align: center;
  padding-bottom: 24rpx;
}

.scan-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
  display: inline-block;
}

.scan-icon.scanning-anim {
  animation: scanPulse 1.5s ease-in-out infinite;
}

@keyframes scanPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.15); opacity: 0.7; }
}

.scale-scan-hint {
  display: block;
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

/* 设备列表 */
.scale-device-list {
  max-height: 400rpx;
  overflow-y: auto;
  margin-bottom: 24rpx;
  -webkit-overflow-scrolling: touch;
}

.no-devices {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.no-devices-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.no-devices-text {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-bottom: 24rpx;
}

.retry-btn {
  font-size: 26rpx;
  color: #3B82F6;
  background: #EFF6FF;
  border-radius: 12rpx;
  padding: 12rpx 36rpx;
  border: none;
  line-height: 1;
  height: auto;
}

.retry-btn::after { border: none; }
.retry-btn:active { opacity: 0.7; }

/* 设备条目 */
.device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  background: #F8FAFC;
  margin-bottom: 12rpx;
  transition: all 0.2s;
}

.device-item:active {
  background: #EFF6FF;
  transform: scale(0.98);
}

.device-item.device-duplicate {
  opacity: 0.6;
}

.device-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.device-item-icon {
  font-size: 40rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
  border-radius: 14rpx;
  flex-shrink: 0;
}

.device-item-info {
  flex: 1;
  min-width: 0;
}

.device-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-item-meta {
  font-size: 22rpx;
  color: #9CA3AF;
}

.device-item-right {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.duplicate-tag {
  font-size: 22rpx;
  color: #EF4444;
  background: #FEF2F2;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

/* 信号强度柱状图 */
.signal-bars {
  display: flex;
  align-items: flex-end;
  gap: 3rpx;
  height: 32rpx;
}

.signal-bar {
  width: 8rpx;
  border-radius: 2rpx;
  background: #E5E7EB;
  transition: all 0.3s;
}

.signal-bar:nth-child(1) { height: 8rpx; }
.signal-bar:nth-child(2) { height: 14rpx; }
.signal-bar:nth-child(3) { height: 22rpx; }
.signal-bar:nth-child(4) { height: 32rpx; }

.signal-bar.active {
  background: #10B981;
}

.scan-footer {
  padding-top: 8rpx;
}


