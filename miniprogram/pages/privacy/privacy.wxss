/* ========================================
 * 隐私协议页面 — 赛博科幻风
 * ======================================== */

.page {
  min-height: 100vh;
  background: linear-gradient(145deg, #0a0a1a 0%, #151535 30%, #1a1040 60%, #0d0d2b 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 30rpx 60rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(100rpx);
  opacity: 0.25;
  pointer-events: none;
  z-index: 0;
}

.bg-orb-1 {
  width: 500rpx; height: 500rpx;
  background: radial-gradient(circle, #667eea, transparent 70%);
  top: -150rpx; left: -100rpx;
}

.bg-orb-2 {
  width: 400rpx; height: 400rpx;
  background: radial-gradient(circle, #764ba2, transparent 70%);
  bottom: -100rpx; right: -80rpx;
}

.card {
  width: 100%;
  max-width: 700rpx;
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.4);
  position: relative;
  z-index: 1;
  overflow: hidden;
}

/* ---------- Tab 切换栏 ---------- */
.tab-bar {
  display: flex;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  position: sticky;
  top: 0;
  z-index: 2;
  background: rgba(10, 10, 26, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active .tab-text {
  color: #ffffff;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 15%;
  right: 15%;
  height: 3rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 2rpx;
}

.tab-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* ---------- 内容滚动 ---------- */
.content-scroll {
  height: 1000rpx;
  padding: 32rpx 36rpx 48rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
  text-shadow: 0 0 20rpx rgba(102, 126, 234, 0.3);
}

.update-date {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-bottom: 4rpx;
}

/* ---------- 文章 ---------- */
.article {
  margin-top: 28rpx;
}

.article-title {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(102, 126, 234, 0.9);
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.article-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.7;
  white-space: pre-line;
  word-break: break-all;
}
