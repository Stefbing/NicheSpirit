/* ========================================
 * 设置页 — 赛博科幻风
 * ======================================== */

.page {
  min-height: 100vh;
  background: linear-gradient(145deg, #0a0a1a 0%, #151535 30%, #1a1040 60%, #0d0d2b 100%);
  padding: 30rpx 30rpx 80rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(100rpx);
  opacity: 0.2;
  pointer-events: none;
  z-index: 0;
}

.bg-orb-1 {
  width: 500rpx; height: 500rpx;
  background: radial-gradient(circle, #667eea, transparent 70%);
  top: -150rpx; right: -100rpx;
}

.bg-orb-2 {
  width: 400rpx; height: 400rpx;
  background: radial-gradient(circle, #764ba2, transparent 70%);
  bottom: -80rpx; left: -80rpx;
}

.bg-orb-3 {
  width: 300rpx; height: 300rpx;
  background: radial-gradient(circle, #00d4ff, transparent 70%);
  top: 40%; left: 60%;
}

/* ---------- 个人卡片 ---------- */
.profile-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
  animation: ani-fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) both;
}

@keyframes ani-fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 0 30rpx rgba(102, 126, 234, 0.3);
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
}

.profile-phone {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 6rpx;
  display: block;
}

/* ---------- 列表容器 ---------- */
.settings-list {
  position: relative;
  z-index: 1;
}

/* ---------- 分区标题 ---------- */
.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 8rpx 16rpx;
  animation: ani-fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.section-icon {
  font-size: 28rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

/* ---------- 分区卡片组 ---------- */
.section-cards {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  overflow: hidden;
  animation: ani-fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* ---------- 设置卡片 ---------- */
.setting-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
  transition: background 0.2s;
}

.setting-card:last-child {
  border-bottom: none;
}

.setting-card:active {
  background: rgba(102, 126, 234, 0.08);
}

.setting-card.danger-card:active {
  background: rgba(255, 77, 79, 0.08);
}

.card-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-text {
  font-size: 26rpx;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  display: block;
}

.card-title-danger {
  color: #ff4d4f;
}

.card-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-desc-danger {
  color: rgba(255, 77, 79, 0.5);
}

.card-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.15);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.card-arrow-danger {
  color: rgba(255, 77, 79, 0.3);
}

.setting-card:active .card-arrow {
  color: #667eea;
}

.danger-card:active .card-arrow {
  color: #ff4d4f;
}

/* ---------- 关于卡片 ---------- */
.about-card {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  padding: 24rpx;
  animation: ani-fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.about-item {
  padding: 16rpx 0;
}

.about-label {
  font-size: 24rpx;
  color: rgba(102, 126, 234, 0.8);
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.about-value {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  display: block;
  line-height: 1.6;
}

.about-desc {
  white-space: pre-line;
  letter-spacing: 0.5rpx;
}

.about-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.04);
}

/* ---------- 分享管理 ---------- */
.share-loading, .share-empty {
  padding: 40rpx 24rpx;
  text-align: center;
}
.share-empty .empty-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}
.share-empty .empty-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.4);
  display: block;
}
.share-empty .empty-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.25);
  display: block;
  margin-top: 8rpx;
}

.share-card {
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(255,255,255,0.04);
}
.share-card:last-child {
  border-bottom: none;
}

.share-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.share-user-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.share-user-icon {
  font-size: 28rpx;
}
.share-user-name {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 500;
}

.share-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
.status-pending {
  background: rgba(251,191,36,0.15);
  color: #F59E0B;
}
.status-active {
  background: rgba(16,185,129,0.15);
  color: #10B981;
}
.status-revoked {
  background: rgba(107,114,128,0.15);
  color: #6B7280;
}

.share-card-body {
  margin-bottom: 16rpx;
}
.share-info-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
}
.share-info-row .info-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
}
.share-info-row .info-value {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}
.share-info-row .info-value-time {
  color: #F59E0B;
  font-weight: 500;
}

.share-card-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.share-card-actions .action-btn {
  font-size: 22rpx;
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  line-height: 1.4;
  height: auto;
  min-width: 120rpx;
}
.share-card-actions .edit-btn {
  background: rgba(102,126,234,0.15);
  color: #818CF8;
  border: none;
}
.share-card-actions .revoke-btn {
  background: rgba(255,77,79,0.12);
  color: #ff6b6b;
  border: none;
}
.share-card-actions .edit-btn:active {
  background: rgba(102,126,234,0.3);
}
.share-card-actions .revoke-btn:active {
  background: rgba(255,77,79,0.25);
}

/* ---------- 修改时效弹窗 ---------- */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.modal-box {
  width: 560rpx;
  background: linear-gradient(145deg, #1e1e3a, #2a1a4a);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
  backdrop-filter: blur(40rpx);
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  text-align: center;
  margin-bottom: 8rpx;
}
.modal-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  text-align: center;
  margin-bottom: 28rpx;
}
.form-group {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  display: block;
  margin-bottom: 12rpx;
}
.form-input {
  width: 100%;
  height: 80rpx;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #ffffff;
  box-sizing: border-box;
}
.form-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  margin-top: 8rpx;
  display: block;
}
.share-btn-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}
.submit-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border: none;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 80rpx;
}
.submit-btn:active {
  opacity: 0.9;
}
.share-cancel-btn {
  width: 100%;
  height: 72rpx;
  background: rgba(255,255,255,0.05);
  border: 1rpx solid rgba(255,255,255,0.1);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  line-height: 72rpx;
}
