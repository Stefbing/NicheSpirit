/* ========================================
 * 设置页 — 赛博科幻风
 * ======================================== */

.page {
  min-height: 100vh;
  background: linear-gradient(145deg, #0a0a1a 0%, #151535 30%, #1a1040 60%, #0d0d2b 100%);
  padding: 30rpx 30rpx 80rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.bg-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(100rpx);
  opacity: 0.2;
  pointer-events: none;
  z-index: 0;
}

.bg-orb-1 {
  width: 500rpx; height: 500rpx;
  background: radial-gradient(circle, #667eea, transparent 70%);
  top: -150rpx; right: -100rpx;
}

.bg-orb-2 {
  width: 400rpx; height: 400rpx;
  background: radial-gradient(circle, #764ba2, transparent 70%);
  bottom: -80rpx; left: -80rpx;
}

.bg-orb-3 {
  width: 300rpx; height: 300rpx;
  background: radial-gradient(circle, #00d4ff, transparent 70%);
  top: 40%; left: 60%;
}

/* ---------- 个人卡片 ---------- */
.profile-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
  animation: ani-fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) both;
}

@keyframes ani-fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 0 30rpx rgba(102, 126, 234, 0.3);
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
}

.profile-phone {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 6rpx;
  display: block;
}

/* ---------- 列表容器 ---------- */
.settings-list {
  position: relative;
  z-index: 1;
}

/* ---------- 分区标题 ---------- */
.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 8rpx 16rpx;
  animation: ani-fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.section-icon {
  font-size: 28rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

/* ---------- 分区卡片组 ---------- */
.section-cards {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  overflow: hidden;
  animation: ani-fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) both;
}

/* ---------- 设置卡片 ---------- */
.setting-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
  transition: background 0.2s;
}

.setting-card:last-child {
  border-bottom: none;
}

.setting-card:active {
  background: rgba(102, 126, 234, 0.08);
}

.setting-card.danger-card:active {
  background: rgba(255, 77, 79, 0.08);
}

.card-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-text {
  font-size: 26rpx;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  display: block;
}

.card-title-danger {
  color: #ff4d4f;
}

.card-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-desc-danger {
  color: rgba(255, 77, 79, 0.5);
}

.card-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.15);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.card-arrow-danger {
  color: rgba(255, 77, 79, 0.3);
}

.setting-card:active .card-arrow {
  color: #667eea;
}

.danger-card:active .card-arrow {
  color: #ff4d4f;
}

/* ---------- 关于卡片 ---------- */
.about-card {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  padding: 24rpx;
  animation: ani-fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) both;
}

.about-item {
  padding: 16rpx 0;
}

.about-label {
  font-size: 24rpx;
  color: rgba(102, 126, 234, 0.8);
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.about-value {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  display: block;
  line-height: 1.6;
}

.about-desc {
  white-space: pre-line;
  letter-spacing: 0.5rpx;
}

.about-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.04);
}
