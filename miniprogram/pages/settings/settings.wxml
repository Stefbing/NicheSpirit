<view class="page">
  <view class="bg-orb bg-orb-1"></view>
  <view class="bg-orb bg-orb-2"></view>
  <view class="bg-orb bg-orb-3"></view>

  <!-- 用户头像与信息 -->
  <view class="profile-card">
    <view class="avatar">{{avatarChar}}</view>
    <view class="profile-info">
      <text class="profile-name">{{nickname || '用户'}}</text>
      <text class="profile-phone">{{phoneDisplay}}</text>
    </view>
  </view>

  <view class="settings-list">

    <!-- ====== 功能区一：账号信息维护与注销区 ====== -->
    <view class="section-header">
      <text class="section-icon">🔐</text>
      <text class="section-title">账号信息维护与注销区</text>
    </view>

    <view class="section-cards">
      <view class="setting-card" bindtap="onChangePassword">
        <view class="card-left">
          <view class="icon-wrap" style="background: rgba(102, 126, 234, 0.15);">
            <text class="icon-text">🔑</text>
          </view>
          <view class="card-body">
            <text class="card-title">修改密码</text>
            <text class="card-desc">更新您的登录密码</text>
          </view>
        </view>
        <text class="card-arrow">›</text>
      </view>

      <view class="setting-card" bindtap="onViewPrivacy">
        <view class="card-left">
          <view class="icon-wrap" style="background: rgba(118, 75, 162, 0.15);">
            <text class="icon-text">📄</text>
          </view>
          <view class="card-body">
            <text class="card-title">隐私协议</text>
            <text class="card-desc">查看《用户服务协议》与《隐私保护政策》</text>
          </view>
        </view>
        <text class="card-arrow">›</text>
      </view>

      <view class="setting-card danger-card" bindtap="onDeleteAccount">
        <view class="card-left">
          <view class="icon-wrap" style="background: rgba(255, 77, 79, 0.15);">
            <text class="icon-text">🗑️</text>
          </view>
          <view class="card-body">
            <text class="card-title card-title-danger">注销账号</text>
            <text class="card-desc card-desc-danger">永久删除账号及所有数据，不可恢复</text>
          </view>
        </view>
        <text class="card-arrow card-arrow-danger">›</text>
      </view>
    </view>

    <!-- ====== 功能区二：各设备账号维护区 ====== -->
    <view class="section-header">
      <text class="section-icon">📱</text>
      <text class="section-title">各设备账号维护区</text>
    </view>

    <view class="section-cards">
      <block wx:for="{{deviceList}}" wx:key="platform">
        <!-- 【修复】自购设备（is_shared=false）→ 可点击编辑账号密码 -->
        <!-- 共享设备（is_shared=true）→ 取消点击跳转，仅展示状态 -->
        <view class="setting-card {{item.is_shared ? 'setting-card-shared' : ''}}"
               bindtap="{{item.is_shared ? '' : 'onEditDeviceConfig'}}"
               data-platform="{{item.platform}}">
          <view class="card-left">
            <view class="icon-wrap" style="background: {{item.iconBg}};">
              <text class="icon-text">{{item.icon}}</text>
            </view>
            <view class="card-body">
              <text class="card-title">
                {{item.label}}
                <text wx:if="{{item.is_shared}}" class="shared-badge">共享</text>
              </text>
              <text class="card-desc" wx:if="{{item.configured && !item.is_shared}}">已配置，点击修改</text>
              <text class="card-desc" wx:elif="{{item.configured && item.is_shared}}">共享设备，无需维护</text>
              <text class="card-desc" wx:else>未配置</text>
            </view>
          </view>
          <text class="card-arrow" wx:if="{{!item.is_shared}}">›</text>
        </view>
      </block>
    </view>

    <!-- ====== 功能区三：分享设备时效维护区 ====== -->
    <view class="section-header" id="share-expiry-section">
      <text class="section-icon">⏰</text>
      <text class="section-title">分享设备时效维护</text>
    </view>

    <view class="section-cards">
      <!-- 加载中 -->
      <view wx:if="{{shareListLoading}}" class="share-loading">
        <text class="loading-text">加载中...</text>
      </view>

      <!-- 无分享记录 -->
      <view wx:elif="{{shareList.length === 0}}" class="share-empty">
        <text class="empty-icon">📤</text>
        <text class="empty-text">暂无分享记录</text>
        <text class="empty-hint">在首页点击 ↗ 按钮分享设备给好友后，可在此管理时效</text>
      </view>

      <!-- 分享列表 -->
      <block wx:else>
        <view wx:for="{{shareList}}" wx:key="id" class="share-card">
          <view class="share-card-header">
            <view class="share-user-info">
              <text class="share-user-icon">👤</text>
              <text class="share-user-name">{{item.to_user_nickname}}</text>
            </view>
            <view class="share-status {{item.statusClass}}">{{item.statusText}}</view>
          </view>

          <view class="share-card-body">
            <view class="share-info-row">
              <text class="info-label">分享设备</text>
              <text class="info-value">{{item.deviceNames}}</text>
            </view>
            <view class="share-info-row">
              <text class="info-label">分享时间</text>
              <text class="info-value">{{item.createdTime}}</text>
            </view>
            <view class="share-info-row" wx:if="{{item.status === 'accepted' || item.status === 'pending'}}">
              <text class="info-label">剩余时效</text>
              <text class="info-value info-value-time">{{item.remainingText}}</text>
            </view>
          </view>

          <view class="share-card-actions">
            <button wx:if="{{item.status === 'accepted'}}" class="action-btn edit-btn"
                    bindtap="onEditExpiry" data-share-id="{{item.id}}">修改时效</button>
            <button wx:if="{{item.status === 'accepted' || item.status === 'pending'}}" class="action-btn revoke-btn"
                    bindtap="onRevokeShare" data-share-id="{{item.id}}">撤销分享</button>
          </view>
        </view>
      </block>
    </view>

    <!-- ====== 功能区四：小程序用途简介区 ====== -->
    <view class="section-header">
      <text class="section-icon">ℹ️</text>
      <text class="section-title">小程序用途简介区</text>
    </view>

    <view class="about-card">
      <view class="about-item">
        <text class="about-label">小程序名称</text>
        <text class="about-value">冷门器灵</text>
      </view>
      <view class="about-divider"></view>
      <view class="about-item">
        <text class="about-label">版本号</text>
        <text class="about-value">v0.5.0</text>
      </view>
      <view class="about-divider"></view>
      <view class="about-item">
        <text class="about-label">功能概述</text>
        <text class="about-value about-desc">一站式智能家居控制中心，支持云宠喂食机远程投喂与计划管理、小佩猫厕所状态监控与清理控制、小米体脂秤蓝牙测量与健康数据分析。通过统一平台管理多品牌智能设备，为您提供便捷的宠物照护与个人健康管理体验。</text>
      </view>
      <view class="about-divider"></view>
      <view class="about-item">
        <text class="about-label">支持设备</text>
        <text class="about-value about-desc">• 云宠（CloudPets）智能喂食机\n• 小佩（PetKit）智能猫厕所（T3/T4/T5）\n• 小米体脂秤 2（XMTZC05HM）</text>
      </view>
      <view class="about-divider"></view>
      <view class="about-item">
        <text class="about-label">注意事项</text>
        <text class="about-value about-desc">• 体脂秤测量数据仅供参考，不构成医疗建议\n• 设备控制依赖第三方API，请确保网络畅通\n• 如遇问题请尝试重新登录或联系客服</text>
      </view>
    </view>
  </view>

  <!-- 修改时效弹窗 -->
  <view wx:if="{{showExpiryModal}}" class="modal-mask" bindtap="closeExpiryModal">
    <view class="modal-box" catchtap="stopPropagation">
      <view class="modal-title">修改分享时效</view>
      <view class="modal-desc">设置"{{editShareName}}"的设备可用时长</view>

      <view class="form-group">
        <text class="form-label">有效时长（小时）</text>
        <input class="form-input" type="number" placeholder="请输入 1~720"
               value="{{editExpiryInput}}" bindinput="onExpiryInput" />
        <text class="form-hint">设置范围：1 小时 ~ 720 小时（30 天）</text>
      </view>

      <view class="share-btn-row">
        <button class="submit-btn" bindtap="confirmUpdateExpiry">确认更新</button>
        <button class="share-cancel-btn" bindtap="closeExpiryModal">取消</button>
      </view>
    </view>
  </view>

  <!-- 设备账号编辑弹窗（自购设备） -->
  <view wx:if="{{showEditAccountModal}}" class="modal-mask" bindtap="closeEditAccountModal">
    <view class="modal-box" catchtap="stopPropagation">
      <view class="modal-title">维护{{editAccountLabel}}账号</view>
      <view class="modal-desc">直接在此更新设备登录凭据</view>

      <view class="form-group">
        <text class="form-label">设备账号</text>
        <input class="form-input" placeholder="请输入账号"
               value="{{editAccountValue}}" bindinput="onEditAccountInput" />
      </view>

      <view class="form-group">
        <text class="form-label">密码</text>
        <input class="form-input" type="password" placeholder="请输入密码"
               value="{{editPasswordValue}}" bindinput="onEditPasswordInput" />
      </view>

      <view class="share-btn-row">
        <button class="submit-btn" bindtap="confirmEditAccount"
                disabled="{{editIsSaving}}">保存更新</button>
        <button class="share-cancel-btn" bindtap="closeEditAccountModal">取消</button>
      </view>
    </view>
  </view>

</view>
